% ============================================================
% 13) Series Axiom fragments (print only what you need)
% ============================================================
% We define:
%  - a lightweight environment for an axiom block
%  - fixed-numbered “SA#” items as individual commands
%  - each item has a "...Text" version (inline) and a printed version

\newtheorem*{seriesaxiom}{Series Axiom}
\makeatletter
\newcommand{\FP@SAitem}[2]{\par\noindent\textbf{SA#1.} #2\par}

% ---------- Core (FP I–II and used everywhere) ----------
\newcommand{\FPAxiomGeometryText}{%
$Y$ is a smooth manifold and we consider smooth bundles $\pi_n:B_n\to Y$ with compact fibers.%
}
\newcommand{\FPAxiomGeometry}{\FP@SAitem{1}{\FPAxiomGeometryText}}

\newcommand{\FPAxiomBoundedGeometryText}{%
All (base/fiber) geometries used in estimates are in a bounded-geometry class sufficient for uniform elliptic/spectral calculus.%
}
\newcommand{\FPAxiomBoundedGeometry}{\FP@SAitem{2}{\FPAxiomBoundedGeometryText}}

\newcommand{\FPAxiomLaplacianSignText}{%
All Laplace-type operators denoted by $\Delta$ are taken nonnegative in the spectral sense (eigenvalues $\ge 0$). Dissipative flows are written with a minus sign in front of the nonnegative operator.%
}
\newcommand{\FPAxiomLaplacianSign}{\FP@SAitem{3}{\FPAxiomLaplacianSignText}}

\newcommand{\FPAxiomUniformGapText}{%
There is a uniform positive fiber gap $\lamstar>0$ separating the coherent/harmonic sector from the first noncoherent band, so the coherent projector $\Pcoh$ (e.g.\ Riesz projector) is well-defined uniformly.%
}
\newcommand{\FPAxiomUniformGap}{\FP@SAitem{4}{\FPAxiomUniformGapText}}

\newcommand{\FPAxiomProjectedMapText}{%
The operational fixed-point map is the projected time-$\tau$ map $\Ttau:=\Pcoh\circ\Phi_\tau$.%
}
\newcommand{\FPAxiomProjectedMap}{\FP@SAitem{5}{\FPAxiomProjectedMapText}}

\newcommand{\FPAxiomCoherenceInvarianceText}{%
A fixed point of $\Ttau$ is identified with a true equilibrium of the underlying flow only under coherence invariance (the coherent sector is dynamically invariant under the evolution).%
}
\newcommand{\FPAxiomCoherenceInvariance}{\FP@SAitem{6}{\FPAxiomCoherenceInvarianceText}}

% ---------- Disturbance / damping (FP III+) ----------
\newcommand{\FPAxiomDisturbanceDampingText}{%
Modewise stability under persistent forcing is governed by an effective damping margin $\gamma>0$; in OU linearization, stationary variances scale like $\mathrm{Var}\sim \sigma^2/(2\gamma)$.%
}
\newcommand{\FPAxiomDisturbanceDamping}{\FP@SAitem{7}{\FPAxiomDisturbanceDampingText}}

% ---------- Curvature remainder (FP IV+) ----------
\newcommand{\FPAxiomCurvatureRemainderText}{%
On curved bases, curvature-induced lower-order terms are controlled by a bounded-geometry remainder $\Dcurv(Y)$ and must be included in stability/damping margins wherever applicable.%
}
\newcommand{\FPAxiomCurvatureRemainder}{\FP@SAitem{8}{\FPAxiomCurvatureRemainderText}}

% ---------- Gap coupling + positivity window (FP V+) ----------
\newcommand{\FPAxiomGapCouplingText}{%
\textit{Gap coupling and positivity window.} Position-dependent gaps may depend on covariant scalar diagnostics $\{\Xi_\alpha\}$ via
\[
\lambda_a(x)=\lambda_{a,0}+\sum_\alpha \beta_{a;\alpha}\,\Xi_\alpha(x),
\qquad \text{with the positivity window } \lambda_a(x)\ge \lammin>0 \text{ on the coherent domain.}
\]
}
\newcommand{\FPAxiomGapCoupling}{\FP@SAitem{9}{\FPAxiomGapCouplingText}}

% ---------- Selection/Drivers (FP V–VI) ----------
\newcommand{\FPAxiomSelectionAdmissibilityText}{%
Selection/Drivers are treated as meta-level admissibility constraints: coherent evolution is asserted only while $\Phisel<\Phicrit$; $\Phisel$ is not added to the physical action unless stated as an explicit optional soft-penalty variant.%
}
\newcommand{\FPAxiomSelectionAdmissibility}{\FP@SAitem{10}{\FPAxiomSelectionAdmissibilityText}}

% ---------- Action/kernel (FP V–VI, when used) ----------
\newcommand{\FPAxiomKernelHypothesisText}{%
If a bilocal overlap kernel $K_{ab}(x,y)$ is used, it is assumed symmetric/nonnegative and integrable in each variable on Cauchy slices (and supported on equal-time pairs or derived from integrating out a massive local mediator), ensuring boundedness in the Sobolev spaces used.%
}
\newcommand{\FPAxiomKernelHypothesis}{\FP@SAitem{11}{\FPAxiomKernelHypothesisText}}

% Convenience: print a full “Series Axiom” block (optional)
\newcommand{\FPPrintSeriesAxiomAll}{%
\begin{seriesaxiom}
\FPAxiomGeometry
\FPAxiomBoundedGeometry
\FPAxiomLaplacianSign
\FPAxiomUniformGap
\FPAxiomProjectedMap
\FPAxiomCoherenceInvariance
\FPAxiomDisturbanceDamping
\FPAxiomCurvatureRemainder
\FPAxiomGapCoupling
\FPAxiomSelectionAdmissibility
\FPAxiomKernelHypothesis
\end{seriesaxiom}
}

% ============================================================
% 14) One-line “formula macros” (drop anywhere)
% ============================================================
\newcommand{\FPProjectedMapFormula}{\[
\Ttau := \Pcoh \circ \Phi_{\tau}.
\]}

\newcommand{\FPOUVarianceFormula}{\[
\text{OU:}\qquad \mathrm{Var}[a] = \frac{\sigma^{2}}{2\gamma}\quad(\gamma>0).
\]}

\newcommand{\FPSelectionPotentialFormula}{\[
\Phisel(x) := -\sum_a w_a\,\lambda_a(x),\qquad w_a>0,\qquad \text{admissible if }\Phisel(x)<\Phicrit.
\]}

\newcommand{\FPGapCouplingFormula}{\[
\lambda_a(x)=\lambda_{a,0}+\sum_\alpha \beta_{a;\alpha}\,\Xi_\alpha(x),
\qquad \lambda_a(x)\ge \lammin>0.
\]}

