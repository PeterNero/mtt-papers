% ============================================================
% 10) Hardening: NEVER break on "\lambda^\*" again
% ============================================================
% LaTeX's \* is a *text* discretionary-break macro, NOT a math star.
% If someone writes "\lambda^\*", compilation can fail in math mode.
% Fix: keep the original \* in text mode, but in math mode make it \ast.

\providecommand{\*}{\discretionary{}{}{}} % define if missing (safety)
\makeatletter
\let\FP@origtextstar\*
\DeclareRobustCommand{\*}{\ifmmode\ast\else\FP@origtextstar\fi}
\makeatother

